# Clerk Auth (free tier: clerk.com)
# The publishable key is safe to expose to the browser.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
# SECRET — server-side only. Never commit a real value here.
CLERK_SECRET_KEY=sk_test_your_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Backend API base URL (public — this is just an endpoint, not a secret)
NEXT_PUBLIC_API_URL=http://localhost:8000

# NOTE ON SECRETS IN THE FRONTEND:
# Do NOT put provider API keys (Gemini, ElevenLabs, etc.) in NEXT_PUBLIC_* vars.
# Anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle and is readable
# by anyone. All Gemini/Groq/LLM calls go through the FastAPI backend, which holds
# those keys server-side. If you add text-to-speech, proxy it through the backend too.
